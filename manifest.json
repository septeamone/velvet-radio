{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.6.0",
  "description": "__MSG_extDescription__",
  "default_locale": "ru",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://meta.hostingradio.ru/*",
    "https://www.radiorecord.ru/*",
    "https://rms.api.bbc.co.uk/*",
    "https://rusradio.ru/*",
    "https://dfm.ru/*",
    "https://maximum.ru/*",
    "https://hitfm.ru/*",
    "https://montecarlo.ru/*",
    "https://hls-01-gpm.hostingradio.ru/*",
    "https://pub0201.101.ru/*",
    "https://stream2.n340.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png",
      "48": "icons/idle48.png",
      "128": "icons/idle128.png"
    }
  },
  "icons": {
    "16": "icons/idle16.png",
    "32": "icons/idle32.png",
    "48": "icons/idle48.png",
    "128": "icons/idle128.png"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmd_toggle__"
    },
    "next": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "__MSG_cmd_next__"
    },
    "prev": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "__MSG_cmd_prev__"
    }
  }
}
